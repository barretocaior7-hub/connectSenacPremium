# ==========================================
# Connect Senac - Variáveis de Ambiente
# ==========================================

# Configuração da Porta Local (Opcional)
PORT=3000

# Conexão com o Supabase (Obrigatórias)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua-chave-anon-ou-service-role

# Autenticação e Segurança (Obrigatória)
JWT_SECRET=sua_chave_secreta_jwt_longa_e_segura

# Google Gemini IA (Assistente Virtual Connect AI)
GEMINI_API_KEY=sua_chave_api_google_ai_studio
GEMINI_MODEL=gemini-3.5-flash-lite
