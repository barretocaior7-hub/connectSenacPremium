# ==============================================================================
# CONNECT SENAC - VARIÁVEIS DE AMBIENTE (EXEMPLO)
# ==============================================================================

# 1. SUPABASE (OBRIGATÓRIO)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua-chave-anon-ou-service-role

# 2. AUTENTICAÇÃO JWT (OBRIGATÓRIO NO VERCEL / PRODUÇÃO)
JWT_SECRET=sua_chave_secreta_jwt_longa_e_segura

# 3. GOOGLE GEMINI AI - ASSISTENTE VIRTUAL (RECOMENDADO)
GEMINI_API_KEY=sua_chave_api_google_ai_studio
GEMINI_MODEL=gemini-3.5-flash-lite

# 4. GOOGLE OAUTH LOGIN (OPCIONAL / RECOMENDADO)
GOOGLE_CLIENT_ID=seu_client_id_google_oauth.apps.googleusercontent.com

# 5. AMBIENTE
NODE_ENV=production

