{
  "version": 2,
  "crons": [
    {
      "path": "/api/cron/notificador",
      "schedule": "*/5 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/cursos/:id",
      "destination": "/api/index.js"
    },
    {
      "source": "/cursos",
      "destination": "/cursos.html"
    }
  ]
}
